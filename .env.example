# Settings for launch-cert-rotate. `sudo launch-cert-rotate setup` writes these to
# /etc/launch-cert-rotate/env for you; this file only documents the keys.

# Launch API for your region, e.g. https://launch-api.contentstack.com
LAUNCH_HOST=
# Authtoken of the Contentstack user that manages the domain
LAUNCH_AUTHTOKEN=
LAUNCH_ORG_UID=
LAUNCH_PROJECT_UID=
LAUNCH_ENVIRONMENT_UID=
# Launch domains that share the certificate, comma-separated
LAUNCH_DOMAINS=

# Hostinger API token (hPanel → Profile → API), used to create certbot's DNS record
HOSTINGER_API_TOKEN=
# Optional: email for Let's Encrypt account notices
LETSENCRYPT_EMAIL=
